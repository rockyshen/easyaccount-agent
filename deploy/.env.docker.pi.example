BASE_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:17-jre

SPRING_AI_DASHSCOPE_API_KEY=sk-xxxxxxxx
SERVER_PORT=8088

DB_HOST=
DB_PORT=3307
DB_USER=
DB_PASSWORD=

EASYACCOUNT_AUTH_ENABLED=true
EASYACCOUNT_AUTH_TOKEN_TTL_DAYS=30
EASYACCOUNT_AUTH_SLIDING_RENEW_DAYS=7

# 监控栈（Prometheus / Grafana，仅本机监听）
PROMETHEUS_IMAGE=docker.m.daocloud.io/prom/prometheus:v2.54.1
GRAFANA_IMAGE=docker.m.daocloud.io/grafana/grafana:11.2.0
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
PROMETHEUS_RETENTION=3d
PROMETHEUS_RETENTION_SIZE=512MB
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=http://127.0.0.1:3000
