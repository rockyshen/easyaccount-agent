ARG BASE_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:17-jre
ARG JAR_FILE
FROM ${BASE_IMAGE}

WORKDIR /app

ARG JAR_FILE
RUN test -n "${JAR_FILE}" || (echo "ERROR: build-arg JAR_FILE 未设置" >&2 && exit 1)

COPY target/${JAR_FILE} app.jar
RUN test -f app.jar && ! test -d app.jar

COPY deploy/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh \
    && mkdir -p /var/log/easyaccount-agent

ENV APP_NAME=easyaccount-agent \
    LOG_HOME=/var/log/easyaccount-agent \
    JVM_MAX=384m

ENTRYPOINT ["/app/docker-entrypoint.sh"]
